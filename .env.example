# AEGIS — Ortam Değişkenleri (ŞABLON)
# Bu dosya gerçek sır İÇERMEZ. Kopyalayıp `.env` oluşturun ve doldurun.
#   cp .env.example .env
# .env dosyası .gitignore ile korunur; asla commit edilmez (gitleaks CI'da bekçi).

# ── Uygulama ────────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000 # virgülle ayrılmış liste

# ── Veritabanı (PostgreSQL 16) ───────────────────────────────────────────────
# Uygulama bağlantısı: RLS'ye TABİ, süper-kullanıcı OLMAYAN rol (compose oluşturur).
DATABASE_URL=postgresql+psycopg://aegis_app:aegis_app@localhost:5432/aegis
# Migration/DDL için ayrıcalıklı bağlantı (owner/superuser). Bkz. ADR-0002.
DATABASE_ADMIN_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis

# ── Redis (Celery broker/backend + oran sınırlama) ───────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Nesne Depolama (MinIO / S3-uyumlu) — E1.4'te belge yükleme için ──────────
OBJECT_STORAGE_ENDPOINT_URL=       # ör. http://localhost:9000 (MinIO)
OBJECT_STORAGE_BUCKET=aegis-documents
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto

# ── Tarama motoru (yente) — E1.3'te bağlanır ─────────────────────────────────
# KVKK: kendi ortamımızda self-host; PII asla dış tarama API'sine çıkmaz.
YENTE_URL=http://localhost:8001

# ── Gözlemlenebilirlik ───────────────────────────────────────────────────────
SENTRY_DSN=
# Web (tarayıcı + Next sunucusu) için ayrı DSN; boşsa Sentry tamamen kapalı.
NEXT_PUBLIC_SENTRY_DSN=

# ── Kimlik Doğrulama ─────────────────────────────────────────────────────────
AUTH_SECRET=                       # `openssl rand -base64 32` ile üretin (prod'da zorunlu)
# Güvenilir ters-proxy sayısı: X-Forwarded-For'un sondan kaç girdisi güvenilir
# altyapıdan (Next proxy / LB) gelir. 0 = XFF yok sayılır. Compose api servisi 1 kullanır.
TRUSTED_PROXY_COUNT=0
# Oran sınırlama (varsayılanlar): e-posta 5 / IP 20 deneme, 300 sn pencere.
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_IP_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# ── Frontend (apps/web) ──────────────────────────────────────────────────────
# Tarayıcıya gömülür (NEXT_PUBLIC_*). Backend API'nin tarayıcıdan erişilen kök adresi.
NEXT_PUBLIC_API_URL=http://localhost:8000

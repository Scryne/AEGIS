# AEGIS — Ortam Değişkenleri (ŞABLON)
# Bu dosya gerçek sır İÇERMEZ. Kopyalayıp `.env` oluşturun ve doldurun.
#   cp .env.example .env
# .env dosyası .gitignore ile korunur; asla commit edilmez (gitleaks CI'da bekçi).

# ── Uygulama ────────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000 # virgülle ayrılmış liste

# ── Veritabanı (PostgreSQL 16) ───────────────────────────────────────────────
# Uygulama bağlantısı: RLS'ye TABİ, süper-kullanıcı OLMAYAN rol (compose oluşturur).
DATABASE_URL=postgresql+psycopg://aegis_app:aegis_app@localhost:5432/aegis
# Migration/DDL için ayrıcalıklı bağlantı (owner/superuser). Bkz. ADR-0002.
DATABASE_ADMIN_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis

# ── Redis (Celery broker/backend + oran sınırlama) ───────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Nesne Depolama (MinIO / S3-uyumlu) — belge saklama, E1.4 ─────────────────
# Belgeler veritabanında DEĞİL burada tutulur: DB yedeği PII taşıyan PDF'leri
# sürüklemesin, saklama süresi imhası (E3.7) dosyayı ayrı silebilsin.
OBJECT_STORAGE_ENDPOINT_URL=       # ör. http://localhost:9000 (MinIO)
OBJECT_STORAGE_BUCKET=aegis-documents
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto

# ── Belge yükleme / çıkarım — E1.4 ───────────────────────────────────────────
MAX_DOCUMENT_SIZE_MB=25
# İndirme bağlantısı ömrü (sn) — kısa tutulur, kalıcı erişim kapısı bırakmaz.
DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=300
# Not: Docling (PDF çıkarımı) yalnız worker imajında kuruludur (`--group extraction`).
# Kurulu değilse belge saklanır, çıkarım "skipped" olur ve alanlar elle girilir.

# ── Dış zenginleştirme: GLEIF LEI kütüğü — E1.4 ──────────────────────────────
# KVKK: dışarı çıkan TEK şey LEI kodudur (kamuya açık tanımlayıcı); ad/adres/vergi no/
# TCKN asla gönderilmez. Her sorgu denetim olayı yazar. Kapatmak için false yapın.
GLEIF_ENABLED=true
GLEIF_API_URL=https://api.gleif.org/api/v1
GLEIF_TIMEOUT_SECONDS=15

# ── Tarama motoru (yente) — E1.3 ─────────────────────────────────────────────
# KVKK: kendi ortamımızda self-host; PII asla dış tarama API'sine çıkmaz.
YENTE_URL=http://localhost:8001
# Sorgulanan kapsam. Compose'da `aegis_all` (OpenSanctions + MASAK, manifest'te
# tanımlı); manifest bağlı değilken `default`.
YENTE_DATASET=default
YENTE_ALGORITHM=logic-v1
# Senkron yol NFR'si < 30 sn; istemci zaman aşımı bunun altında kalmalı.
YENTE_TIMEOUT_SECONDS=20
YENTE_WORKER_TIMEOUT_SECONDS=120
# yente'nin /updatez ucunu tetiklemek için jeton (yente tarafında da aynısı ayarlanır).
# Boşsa yente kendi zamanlayıcısıyla yenilenir; job yalnız tazeliği ölçer.
YENTE_UPDATE_TOKEN=

# ── Tarama davranışı — E1.3 ──────────────────────────────────────────────────
SCREENING_CANDIDATE_LIMIT=10       # özne başına azami aday
SCREENING_SYNC_SUBJECT_LIMIT=5     # üstü derin koşuya (Celery) gider
SANCTIONS_STALENESS_HOURS=24       # aşılırsa bayatlık alarmı (Sentry + arayüz uyarısı)
# Not: eşik bandı (auto_dismiss_below / auto_flag_at) env'den DEĞİL, kiracı başına
# `screening.thresholds` ayarından okunur — her ofis kendi risk iştahını belirler.

# ── MASAK malvarlığı dondurma listesi (özel FtM veri kümesi) — E1.3 ──────────
MASAK_DATASET_NAME=masak_dondurma
# Kaynak: makine-okur URL ya da operatörün paylaşılan hacme bıraktığı CSV. İkisi de
# boşsa MASAK yenileme adımı atlanır (günlük job düşmez, yalnız loglar).
MASAK_SOURCE_URL=
MASAK_SOURCE_PATH=
# yente manifest'inin okuduğu dosya (worker yazar, yente salt-okunur bağlar).
MASAK_ENTITIES_PATH=/manifests/masak/entities.ftm.json

# ── Saklama süresi (KVKK, Invariant 4) ───────────────────────────────────────
# Belge/dosya saklama süresi (yıl); ilişki bitiminden itibaren ≥5. İmha job'ı
# şimdilik kuru çalışır (E3.7'de silmeye döner).
DOCUMENT_RETENTION_YEARS=5

# ── Gözlemlenebilirlik ───────────────────────────────────────────────────────
SENTRY_DSN=
# Web (tarayıcı + Next sunucusu) için ayrı DSN; boşsa Sentry tamamen kapalı.
NEXT_PUBLIC_SENTRY_DSN=

# ── Alan-düzeyi Şifreleme (KVKK) — E1.4'te entity.national_id'ye BAĞLANDI ────
# TCKN bu anahtarla şifrelenir; aynı anahtar kör indeksi (blind_index) de üretir.
# UYARI: anahtar değişirse mevcut TCKN'ler çözülemez VE kör indeksler eşleşmez —
# rotasyon, kayıtların yeniden şifrelenmesini gerektirir (E1.6 ops runbook'u).
# AES-256 anahtarı, base64(32 bayt). Production'da ZORUNLU; asla git'e commit'lemeyin.
#   uv run python -c "from aegis_core.security.encryption import generate_key; print(generate_key())"
FIELD_ENCRYPTION_KEY=

# ── Kimlik Doğrulama ─────────────────────────────────────────────────────────
AUTH_SECRET=                       # `openssl rand -base64 32` ile üretin (prod'da zorunlu)
# Güvenilir ters-proxy sayısı: X-Forwarded-For'un sondan kaç girdisi güvenilir
# altyapıdan (Next proxy / LB) gelir. 0 = XFF yok sayılır. Compose api servisi 1 kullanır.
TRUSTED_PROXY_COUNT=0
# Oran sınırlama (varsayılanlar): e-posta 5 / IP 20 deneme, 300 sn pencere.
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_IP_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# ── Frontend (apps/web) ──────────────────────────────────────────────────────
# Tarayıcıya gömülür (NEXT_PUBLIC_*). Backend API'nin tarayıcıdan erişilen kök adresi.
NEXT_PUBLIC_API_URL=http://localhost:8000

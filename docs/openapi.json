{
  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "description": "Yalnız yeni erişim token'ı (refresh yanıtı).",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token"
        ],
        "title": "AccessTokenResponse",
        "type": "object"
      },
      "ChainVerificationResponse": {
        "description": "Hash zinciri doğrulama sonucu.",
        "properties": {
          "broken_seq": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Broken Seq"
          },
          "events_checked": {
            "title": "Events Checked",
            "type": "integer"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "ok",
          "events_checked"
        ],
        "title": "ChainVerificationResponse",
        "type": "object"
      },
      "Environment": {
        "description": "Çalışma ortamları.",
        "enum": [
          "development",
          "staging",
          "production"
        ],
        "title": "Environment",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Liveness yanıtı.",
        "properties": {
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "description": "E-posta/parola ile giriş.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MemberResponse": {
        "description": "Kiracıdaki bir üye (kullanıcı + rol).",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email",
          "full_name",
          "role"
        ],
        "title": "MemberResponse",
        "type": "object"
      },
      "PasswordResetConfirm": {
        "description": "Parola sıfırlama onayı (token + yeni parola).",
        "properties": {
          "new_password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "New Password",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "new_password"
        ],
        "title": "PasswordResetConfirm",
        "type": "object"
      },
      "PasswordResetRequest": {
        "description": "Parola sıfırlama talebi (e-posta).",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "PasswordResetRequest",
        "type": "object"
      },
      "PasswordResetResponse": {
        "description": "Parola sıfırlama talebi yanıtı.\n\nE-posta teslimi Phase 1'de (E1.6 onboarding) bağlanır; production'da yanıt\nher zaman aynıdır (kullanıcı numaralandırmasını önler). development ortamında\n``reset_token`` doğrudan döner — teslimat altyapısı olmadan test/geliştirme için.",
        "properties": {
          "ok": {
            "default": true,
            "title": "Ok",
            "type": "boolean"
          },
          "reset_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reset Token"
          }
        },
        "title": "PasswordResetResponse",
        "type": "object"
      },
      "ReadinessComponent": {
        "description": "Tek bir bağımlılığın (DB, Redis) hazırlık durumu.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "healthy": {
            "title": "Healthy",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "healthy"
        ],
        "title": "ReadinessComponent",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Readiness yanıtı — bağımlılık kontrol sonuçları.",
        "properties": {
          "components": {
            "items": {
              "$ref": "#/components/schemas/ReadinessComponent"
            },
            "title": "Components",
            "type": "array"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "ready",
          "components"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RefreshRequest": {
        "description": "Yenileme token'ıyla yeni erişim token'ı talebi.",
        "properties": {
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "description": "Yeni organizasyon + owner kullanıcı kaydı.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "org_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Org Name",
            "type": "string"
          },
          "org_slug": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$",
            "title": "Org Slug",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "org_name",
          "org_slug",
          "email",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "Role": {
        "description": "AEGIS RBAC rolleri (Ürün Planı §6.3).\n\n- ``OWNER``: ofis sahibi; tam yetki (kullanıcı yönetimi dahil).\n- ``COMPLIANCE_OFFICER``: uyum uzmanı; tarama/karar/rapor.\n- ``ANALYST``: dosya hazırlar; tarama çalıştırır, karar öneremez/onaylayamaz.\n- ``AUDITOR``: salt-okunur denetçi; hiçbir mutasyon yapamaz.",
        "enum": [
          "owner",
          "compliance_officer",
          "analyst",
          "auditor"
        ],
        "title": "Role",
        "type": "string"
      },
      "SettingResponse": {
        "description": "Tek bir kiracı ayarı.",
        "properties": {
          "key": {
            "title": "Key",
            "type": "string"
          },
          "value": {
            "additionalProperties": true,
            "title": "Value",
            "type": "object"
          }
        },
        "required": [
          "key",
          "value"
        ],
        "title": "SettingResponse",
        "type": "object"
      },
      "SettingUpsertRequest": {
        "description": "Ayar oluşturma/güncelleme gövdesi.",
        "properties": {
          "value": {
            "additionalProperties": true,
            "title": "Value",
            "type": "object"
          }
        },
        "required": [
          "value"
        ],
        "title": "SettingUpsertRequest",
        "type": "object"
      },
      "TokenResponse": {
        "description": "JWT erişim + yenileme token'ı.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "UserResponse": {
        "description": "Kullanıcı + aktif kiracı + rol.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "full_name",
          "tenant_id",
          "role"
        ],
        "title": "UserResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionResponse": {
        "description": "Servis sürüm/ortam bilgisi.",
        "properties": {
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "environment"
        ],
        "title": "VersionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "AEGIS — KYB / kurumsal due diligence platformu API'si.",
    "title": "AEGIS API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/audit/verify": {
      "get": {
        "description": "Aktif kiracının denetim izi hash zincirini doğrular (kurcalama tespiti).",
        "operationId": "verify_audit_chain_api_v1_audit_verify_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainVerificationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify Audit Chain",
        "tags": [
          "audit"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Kimlik doğrular ve erişim + yenileme token'ı döndürür.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "description": "Geçerli token'a karşılık gelen kullanıcıyı döndürür.",
        "operationId": "me_api_v1_auth_me_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password-reset/confirm": {
      "post": {
        "description": "Sıfırlama token'ını doğrular ve yeni parolayı yazar.",
        "operationId": "password_reset_confirm_api_v1_auth_password_reset_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetConfirm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Password Reset Confirm",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/password-reset/request": {
      "post": {
        "description": "Parola sıfırlama token'ı üretir (e-posta teslimi E1.6'da bağlanır).\n\nKullanıcı yoksa da 202 döner (numaralandırmayı önler). development ortamında\ntoken yanıtta gelir; production'da yalnızca loglanır/e-postalanır.",
        "operationId": "password_reset_request_api_v1_auth_password_reset_request_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordResetResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Password Reset Request",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "Geçerli bir yenileme token'ından yeni bir erişim token'ı üretir.\n\nRolü token'dan değil güncel üyelikten okur; böylece rol değişikliği yenilemede\nyansır (bir kullanıcının rolü düşürüldüyse eski refresh yükseltilmiş erişim vermez).",
        "operationId": "refresh_api_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "Yeni bir organizasyon ve owner kullanıcı oluşturur.",
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/members": {
      "get": {
        "description": "Çağıran kullanıcının kiracısındaki üyeleri listeler (yalnız kendi kiracısı).",

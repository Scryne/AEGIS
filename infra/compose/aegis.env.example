# AEGIS üretim ortam dosyası — ŞABLON. Gerçek değer İÇERMEZ.
#
# Sunucuda: sudo install -m 600 -o root -g root infra/compose/aegis.env.example /etc/aegis/aegis.env
# ve doldurun. Dosya depoya ASLA girmez; yedeği şifreli parola kasasında tutulur.
# Parola/anahtarlar URL içine yazıldığından yalnız hex üretin:  openssl rand -hex 32
#
# !!! FIELD_ENCRYPTION_KEY kaybolursa şifreli TCKN'ler GERİ DÖNMEZ. Veritabanı yedeği bu
# anahtar olmadan eksiktir: anahtarı sunucudan AYRI, çevrimdışı bir yerde de saklayın.

# ── Alan adları / TLS ───────────────────────────────────────────────────────────
AEGIS_DOMAIN=                 # ör. app.ornek-alan.com.tr  (arayüz)
AEGIS_API_DOMAIN=             # ör. api.ornek-alan.com.tr  (genel API)
ACME_EMAIL=                   # sertifika bildirimleri için işletmeci adresi

# ── İmajlar (deploy.sh etiketi kendisi verir) ───────────────────────────────────
AEGIS_IMAGE_REGISTRY=ghcr.io/scryne
AEGIS_IMAGE_TAG=
# MinIO imajı: Docker Hub'daki minio/minio artık yok; erişilebilir bir etiketle doğrulayın.
AEGIS_MINIO_IMAGE=

# ── Veritabanı ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=            # ayrıcalıklı "aegis" rolü (yalnız migrate + yedek)
AEGIS_APP_DB_PASSWORD=        # RLS'ye tabi "aegis_app" rolü (api/worker/beat)

# ── Redis / nesne deposu / tarama motoru ───────────────────────────────────────
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
YENTE_UPDATE_TOKEN=
ES_HEAP=4g
MASAK_SOURCE_URL=

# ── Uygulama sırları (üretimde zorunlu; eksikse uygulama açılmaz) ──────────────
AUTH_SECRET=                  # openssl rand -hex 32
FIELD_ENCRYPTION_KEY=         # uv run python -c "from aegis_core.security.encryption import generate_key; print(generate_key())"
SENTRY_DSN=
DOCUMENT_RETENTION_YEARS=5

# ── E-posta (davet, parola sıfırlama, izleme bildirimi) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ── Yedek (infra/ops/yedek.sh) — ikinci konum: S3-uyumlu, başka sağlayıcı/bölge ──
BACKUP_DIR=/var/backups/aegis
BACKUP_KEEP_DAYS=14
BACKUP_S3_PROVIDER=Other      # rclone s3 provider adı (ör. AWS, Cloudflare, Wasabi, Other)
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# İstemci tarafı şifreleme parolası (rclone crypt). Kaybolursa uzak yedekler AÇILMAZ.
BACKUP_CRYPT_PASSWORD=
BACKUP_CRYPT_SALT=

# ── Sağlık kontrolü / telefona uyarı (infra/ops/saglik.sh) ─────────────────────
# Uyarının POST edileceği adres (ör. kendi ntfy konunuz → telefon bildirimi). Boşsa yalnız günlük.
ALERT_WEBHOOK_URL=
